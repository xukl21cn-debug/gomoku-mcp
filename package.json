{
  "name": "gomoku-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Play Gomoku against an AI agent over MCP",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build:shared": "pnpm --filter @gomoku/shared build",
    "build:server": "pnpm --filter @gomoku/server build",
    "build": "pnpm build:shared && pnpm build:server",
    "test": "pnpm build:shared && pnpm --filter @gomoku/server test",
    "typecheck": "pnpm build:shared && pnpm --filter @gomoku/server typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
